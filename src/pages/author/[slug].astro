---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/cards/BlogCard.astro";
import {
    getAllAuthors,
    getAuthorBySlug,
    getAllPosts,
    type Author,
    type Post,
} from "../../lib/posts";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = async () => {
    const authors = getAllAuthors();
    const posts = await getAllPosts();
    return authors.map((author) => ({
        params: { slug: author.slug },
        props: {
            author,
            posts: posts.filter(
                (p) => p.author.toLowerCase() === author.name.toLowerCase(),
            ),
        },
    }));
};

interface Props {
    author: Author;
    posts: Post[];
}

const { author, posts } = Astro.props;

const socialLinks = [
    { name: "Facebook", url: author.social.facebook, icon: "facebook" },
    { name: "Instagram", url: author.social.instagram, icon: "instagram" },
    { name: "Reddit", url: author.social.reddit, icon: "reddit" },
    { name: "LinkedIn", url: author.social.linkedin, icon: "linkedin" },
].filter((s) => s.url && s.url.trim() !== "");

const structuredData = {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    mainEntity: {
        "@type": "Person",
        name: author.name,
        description: author.bio,
        sameAs: socialLinks.map((s) => s.url),
    },
};
---

<BaseLayout title={`${author.name} — Author`} description={author.bio}>
    <Fragment slot="head">
        <script
            type="application/ld+json"
            set:html={JSON.stringify(structuredData)}
        />
    </Fragment>

    <section class="author-page">
        <div class="container">
            <!-- Author Profile Card -->
            <div class="author-profile-card">
                <div class="author-profile-avatar">
                    {
                        author.avatar ? (
                            <img
                                src={author.avatar}
                                alt={author.name}
                                width="120"
                                height="120"
                            />
                        ) : (
                            <span class="author-profile-initial">
                                {author.name.charAt(0)}
                            </span>
                        )
                    }
                </div>
                <div class="author-profile-details">
                    <h1 class="author-profile-name">{author.name}</h1>
                    <p class="author-profile-bio">{author.bio}</p>
                    <div class="author-profile-stats">
                        <div class="author-stat">
                            <span class="author-stat-number"
                                >{posts.length}</span
                            >
                            <span class="author-stat-label">Articles</span>
                        </div>
                    </div>
                    {
                        socialLinks.length > 0 && (
                            <div class="author-social-links">
                                {socialLinks.map((link) => (
                                    <a
                                        href={link.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class={`author-social-btn author-social-${link.icon}`}
                                        aria-label={`${author.name} on ${link.name}`}
                                    >
                                        {link.icon === "facebook" && (
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="20"
                                                height="20"
                                                viewBox="0 0 24 24"
                                                fill="currentColor"
                                            >
                                                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                                            </svg>
                                        )}
                                        {link.icon === "instagram" && (
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="20"
                                                height="20"
                                                viewBox="0 0 24 24"
                                                fill="currentColor"
                                            >
                                                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
                                            </svg>
                                        )}
                                        {link.icon === "reddit" && (
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="20"
                                                height="20"
                                                viewBox="0 0 24 24"
                                                fill="currentColor"
                                            >
                                                <path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z" />
                                            </svg>
                                        )}
                                        {link.icon === "linkedin" && (
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="20"
                                                height="20"
                                                viewBox="0 0 24 24"
                                                fill="currentColor"
                                            >
                                                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                                            </svg>
                                        )}
                                        <span>{link.name}</span>
                                    </a>
                                ))}
                            </div>
                        )
                    }
                </div>
            </div>

            <!-- Author's Articles -->
            {
                posts.length > 0 && (
                    <div class="author-articles">
                        <h2>Articles by {author.name}</h2>
                        <div class="posts-grid">
                            {posts.map((p) => (
                                <BlogCard post={p} />
                            ))}
                        </div>
                    </div>
                )
            }
        </div>
    </section>
</BaseLayout>

<style>
    .author-page {
        padding: var(--space-10) 0;
        min-height: 60vh;
    }
    .author-profile-card {
        display: flex;
        gap: var(--space-8);
        align-items: flex-start;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl, 1rem);
        padding: var(--space-8);
        margin-bottom: var(--space-10);
        box-shadow: var(--shadow-md);
    }
    .author-profile-avatar {
        flex-shrink: 0;
        width: 120px;
        height: 120px;
        border-radius: 50%;
        overflow: hidden;
        background: var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .author-profile-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .author-profile-initial {
        font-size: 3rem;
        font-weight: 700;
        color: var(--text-inverse);
        line-height: 1;
    }
    .author-profile-details {
        flex: 1;
        min-width: 0;
    }
    .author-profile-name {
        font-size: var(--heading-2);
        font-weight: 800;
        margin: 0 0 var(--space-3) 0;
        color: var(--text-primary);
    }
    .author-profile-bio {
        color: var(--text-secondary);
        font-size: var(--text-base);
        line-height: 1.7;
        margin: 0 0 var(--space-5) 0;
    }
    .author-profile-stats {
        display: flex;
        gap: var(--space-6);
        margin-bottom: var(--space-5);
    }
    .author-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: var(--space-3) var(--space-5);
        background: var(--bg-secondary);
        border-radius: var(--radius-md, 0.5rem);
        border: 1px solid var(--border-light);
    }
    .author-stat-number {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--accent);
        line-height: 1;
    }
    .author-stat-label {
        font-size: var(--text-xs);
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: var(--space-1);
    }
    .author-social-links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3);
    }
    .author-social-btn {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-md, 0.5rem);
        font-size: var(--text-sm);
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s ease;
        border: 1px solid var(--border);
        color: var(--text-secondary);
        background: var(--bg-primary);
    }
    .author-social-btn:hover {
        transform: translateY(-1px);
        box-shadow: var(--shadow-sm);
    }
    .author-social-facebook:hover {
        color: #1877f2;
        border-color: #1877f2;
    }
    .author-social-instagram:hover {
        color: #e4405f;
        border-color: #e4405f;
    }
    .author-social-reddit:hover {
        color: #ff4500;
        border-color: #ff4500;
    }
    .author-social-linkedin:hover {
        color: #0a66c2;
        border-color: #0a66c2;
    }

    .author-articles {
        margin-top: var(--space-8);
    }
    .author-articles h2 {
        font-size: var(--heading-2);
        font-weight: 700;
        margin-bottom: var(--space-6);
        color: var(--text-primary);
    }

    /* Responsive */
    @media (max-width: 768px) {
        .author-profile-card {
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding: var(--space-6);
        }
        .author-profile-avatar {
            width: 96px;
            height: 96px;
        }
        .author-profile-initial {
            font-size: 2.5rem;
        }
        .author-profile-stats {
            justify-content: center;
        }
        .author-social-links {
            justify-content: center;
        }
    }
    @media (max-width: 480px) {
        .author-profile-card {
            padding: var(--space-4);
        }
        .author-profile-avatar {
            width: 80px;
            height: 80px;
        }
        .author-profile-initial {
            font-size: 2rem;
        }
        .author-social-btn span {
            display: none;
        }
        .author-social-btn {
            padding: var(--space-2);
        }
    }
</style>
