---
interface Props {
    siteName?: string;
    description?: string;
}

const {
    siteName = 'TrendBriefly',
    description = 'Independent coverage of software, artificial intelligence, and hardware \u2014 written for Tech Enthusiasts, Power Users, and Gamers who build and play.'
} = Astro.props;
---

<footer class="footer">
    <div class="container">
        <div class="footer-content">
            <div class="footer-section">
                <h3>{siteName}</h3>
                <p>{description}</p>
                <p style="font-size: var(--text-sm); color: var(--text-muted);">getnestdaily.xyz</p>
            </div>

            <div class="footer-section">
                <h4>Topics</h4>
                <ul>
                    <li><a href="/pages/category/technology/">Technology</a></li>
                    <li><a href="/pages/category/artificial-intelligence/">Artificial Intelligence</a></li>
                    <li><a href="/pages/category/software/">Software</a></li>
                    <li><a href="/pages/category/productivity/">Productivity</a></li>
                    <li><a href="/pages/category/business/">Business &amp; Industry</a></li>
                </ul>
            </div>

            <div class="footer-section">
                <h4>Quick Links</h4>
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/pages/blog/">All Articles</a></li>
                    <li><a href="/pages/about/">About</a></li>
                    <li><a href="/pages/contact/">Contact</a></li>
                </ul>
            </div>

            <div class="footer-section">
                <h4>Legal</h4>
                <ul>
                    <li><a href="/pages/privacy-policy/">Privacy Policy</a></li>
                    <li><a href="/pages/terms-of-service/">Terms of Service</a></li>
                    <li><a href="/pages/disclaimer/">Disclaimer</a></li>
                </ul>
            </div>
        </div>

                <!-- Social Links -->
        <div class="footer-social">
            <a href="https://www.linkedin.com/in/kaushik-jagani-119091202/" target="_blank" rel="noopener noreferrer" aria-label="Follow on LinkedIn">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                LinkedIn
            </a>
            <a href="https://x.com/KaushikJagani24" target="_blank" rel="noopener noreferrer" aria-label="Follow on X (Twitter)">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.74l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                Twitter / X
            </a>
        </div>

        <div class="footer-bottom">
            <p style="font-size: var(--text-sm); color: var(--text-muted); margin-bottom: var(--space-2);">{siteName} covers <strong>AI developments</strong>, <strong>software engineering</strong>, <strong>technology news</strong>, and <strong>gaming hardware</strong>. New articles for Power Users and Tech Enthusiasts published regularly.</p>
            <p>&copy; 2026 {siteName}. All rights reserved.</p>
        </div>
    </div>
</footer>
